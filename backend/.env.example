# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# PostgreSQL (Render / Aiven / any managed Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Dev panel — simple shared-secret gate for adding products (not a full admin/role system)
DEV_SECRET=change-me-to-a-long-random-string

# Dev panel login identity — sign up once with these at /dev, then log in with them after
DEV_EMAIL=dev@example.com
DEV_PASSWORD=change-me-to-a-strong-password

# Firebase Admin SDK (Project Settings -> Service Accounts -> Generate new private key)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Keep the \n escapes in the private key exactly as downloaded, wrapped in quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
