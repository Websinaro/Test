# Node environment
NODE_ENV="development"

# Security & JWT configuration
# Generate a strong random secret for production, e.g.: openssl rand -hex 32
JWT_SECRET="change_this_to_a_long_random_secret"

# PostgreSQL Database Configuration
# e.g. a hosted Postgres URL: postgresql://user:password@host:port/database
DATABASE_URL="postgres://user:password@localhost:5432/nexuscart_db"
# Or individual connection params (used if DATABASE_URL is not set):
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=secret
# PGDATABASE=nexuscart_db

# Firebase Web Client Configuration (required for Google Sign-In)
# Get these values from your Firebase project settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
